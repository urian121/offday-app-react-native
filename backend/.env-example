PORT=3000

# Credenciales de Replicate (https://replicate.com/account/api-tokens)
REPLICATE_API_TOKEN=
REPLICATE_MODEL=openai/gpt-4.1-mini
REPLICATE_FALLBACK_MODEL=google/gemini-2.5-flash

# Credenciales de Turso
TURSO_DATABASE_URL=libsql://xxxxx.turso.io
TURSO_AUTH_TOKEN=xxxxxxxx

# Alertas por correo cuando Replicate falle por créditos / token
# Usa una "App Password" de Gmail (no la contraseña normal de la cuenta).
MAIL_USER=
MAIL_PASS=
# Opcional: si no lo pones, el aviso llega a MAIL_USER.
# MAIL_TO=
# Opcional: mínimo entre alertas del mismo tipo (ms). Por defecto 6 horas.
# MAIL_ALERT_COOLDOWN_MS=21600000